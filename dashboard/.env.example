# 대시보드 설정 예시. 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 git 에 올라가지 않음)
# 값은 Supabase 프로젝트(git-coach-dev)에서 직접 복사한다. 레포·채팅에 붙이지 않는다.

# supabase = 실제 DB + GitHub 로그인 / 비워 두면 합성 데이터(로그인 없음)
NEXT_PUBLIC_DATA_SOURCE=

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → anon(publishable) 키. service_role(secret) 키는 절대 넣지 않는다
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 합성 데이터 모드에서만 쓰는 현재 사용자 (기본 jiyoon-lim)
NEXT_PUBLIC_CURRENT_USER=
