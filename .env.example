# 이 파일을 .env 로 복사해 실제 값을 채운다. (cp .env.example .env)
# .env 는 Git 에 올라가지 않는다. 이 파일에는 실제 값을 절대 적지 않는다.

# PC 에서 Ollama 컨테이너에 접속할 포트. "ports are not available" 오류가 나면
# PC 에 설치된 Ollama 등과 겹친 것이므로 21434 처럼 비어 있는 번호로 바꾼다.
OLLAMA_HOST_PORT=11434

# watcher 가 GitHub API 를 호출할 때 쓰는 토큰
GITHUB_TOKEN=

# Supabase 프로젝트 주소 (watcher, dashboard 공용)
SUPABASE_URL=

# 관리자 권한 키: watcher(서버) 전용. 브라우저로 나가는 dashboard 에 넘기면 안 된다.
SUPABASE_SERVICE_KEY=

# 공개용 키: dashboard 전용
SUPABASE_ANON_KEY=

# gitcoach sync (Supabase Edge Function ingest-events). 실제 값은 이남주에게 문의, 11/17~18 발급 예정
GITCOACH_SYNC_URL=
GITCOACH_SYNC_TOKEN=
